{
  "name": "peakcad",
  "version": "1.1.9.4",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "PeakHorologyLLC",
  "description": "Mintr3d — local Windows CAD software by PeakHorologyLLC",
  "homepage": "https://peakhorology.com",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/copy-occt-wasm.mjs",
    "copy:occt": "node scripts/copy-occt-wasm.mjs",
    "stage:legal": "node scripts/stage-legal-notices.mjs",
    "predev": "npm run copy:occt && npm run stage:legal",
    "dev": "next dev apps/web",
    "prebuild": "npm run copy:occt && npm run stage:legal",
    "build": "next build apps/web",
    "preexport": "npm run copy:occt && npm run stage:legal",
    "export": "node scripts/static-export.mjs",
    "verify:static-worker-assets": "node scripts/verify-static-worker-assets.mjs",
    "start": "next start apps/web",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "test:e2e": "vitest run --config tests/vitest.e2e.config.ts",
    "perf": "vitest run --config tests/vitest.perf.config.ts --reporter verbose",
    "ci": "npm run typecheck && npm run test && npm run test:e2e",
    "mcp:peakcad": "node scripts/sketchforge-mcp-server.mjs",
    "mcp:sketchforge": "node scripts/sketchforge-mcp-server.mjs",
    "electron:start": "electron .",
    "prepackage:desktop": "npm run export && node scripts/prepare-desktop-icon.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "prepare:desktop-icon": "node scripts/prepare-desktop-icon.mjs",
    "build:kernel": "powershell -ExecutionPolicy Bypass -File scripts/build-mintr-kernel.ps1"
  },
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/three": "^0.184.1",
    "brepjs": "^18.118.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.511.0",
    "manifold-3d": "^3.5.0",
    "meshoptimizer": "^1.3.0",
    "next": "^15.3.2",
    "occt-wasm": "^3.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.8",
    "three": "^0.184.0",
    "three-bvh-csg": "^0.0.18"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.peakhorology.peakcad",
    "productName": "Mintr3d",
    "copyright": "Copyright © PeakHorologyLLC — licensed under GPL-3.0-or-later",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist-release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "apps/web/.next-export/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "apps/web/.next-export/occt/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "electron/icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "apps/web/public/legal",
        "to": "legal"
      },
      {
        "from": "native/mintr-kernel/dist",
        "to": "mintr-kernel"
      }
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "apps/web/public/legal/SOURCE-OFFER.txt",
        "to": "SOURCE-OFFER.txt"
      },
      {
        "from": "apps/web/public/legal/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "mintr",
          "peakcad"
        ],
        "name": "Mintr3d Project",
        "description": "Mintr3d project file",
        "icon": "build/icon.ico",
        "role": "Editor"
      },
      {
        "ext": "mintrguide",
        "name": "Mintr3d Guide",
        "description": "Mintr3d guide file",
        "icon": "build/icon.ico",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "Mintr",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "packElevateHelper": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "shortcutName": "Mintr3d",
      "uninstallDisplayName": "Mintr3d",
      "artifactName": "PeakCAD-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PeakCAD-${version}-portable.${ext}"
    }
  }
}
